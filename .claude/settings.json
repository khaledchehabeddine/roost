{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/stop-capture-learnings.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cargo fmt --check"
          },
          {
            "type": "command",
            "command": "cargo clippy --quiet -- -D warnings"
          },
          {
            "type": "command",
            "command": "cargo test --quiet"
          },
          {
            "type": "command",
            "command": "cargo llvm-cov -p hermes-core --fail-under-lines 80 --quiet"
          },
          {
            "type": "command",
            "command": "cargo llvm-cov -p hermes-crypto --fail-under-lines 80 --quiet"
          }
        ]
      }
    ]
  }
}
