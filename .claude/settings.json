{
  "permissions": {
    "deny": [
      "Bash(cargo publish*)",
      "Bash(cargo yank*)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(rm -f -r*)",
      "Bash(rm -fr*)",
      "Bash(rm -r -f*)",
      "Bash(rm -rf*)"
    ]
  },
  "hooks": {
    "WorktreeCreate": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/worktree-create.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "bash scripts/hooks/deny.sh"
          }
        ]
      },
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/check.sh"
          }
        ]
      }
    ]
  }
}
