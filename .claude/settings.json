{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/enforce-git-boundary.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "bash scripts/hooks/deny.sh"
          }
        ]
      },
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "scripts/check.sh quick"
          }
        ]
      }
    ]
  },
  "permissions": {
    "ask": [
      "Bash(cargo publish*)",
      "Bash(gh release delete*)",
      "Bash(git clean -d -f*)",
      "Bash(git clean -df*)",
      "Bash(git clean -dfx*)",
      "Bash(git clean -f -d*)",
      "Bash(git clean -fd*)",
      "Bash(git clean -fdx*)",
      "Bash(git reset --hard*)",
      "Bash(git tag --delete*)",
      "Bash(git tag -d*)",
      "Bash(scripts/push-reviewed-branch.sh)",
      "Bash(rm -f -r*)",
      "Bash(rm -fr*)",
      "Bash(rm -r -f*)",
      "Bash(rm -rf*)"
    ],
    "deny": [
      "Bash(cargo yank*)",
      "Bash(gh auth token*)",
      "Bash(gh pr merge*)",
      "Bash(git push*)",
      "Bash(git * push*)"
    ]
  }
}
