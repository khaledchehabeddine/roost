prefix_rule(
    pattern = ["gh", "release", "delete"],
    decision = "prompt",
    match = ["gh release delete v0.3.0"],
    not_match = ["gh release create", "gh release view"],
)

prefix_rule(
    pattern = ["git", "clean"],
    decision = "prompt",
    match = ["git clean -fd", "git clean -f -d src/", "git clean -xdf"],
    not_match = ["git status", "git stash"],
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "prompt",
    match = ["git reset --hard", "git reset --hard HEAD~1"],
    not_match = ["git reset --soft HEAD~1", "git reset HEAD file.rs", "git reset --keep HEAD~1"],
)

prefix_rule(
    pattern = ["rm", ["-r", "-R", "--recursive", "-f", "--force"], ["-r", "-R", "--recursive", "-f", "--force"]],
    decision = "prompt",
    match = ["rm -r -f target", "rm -f -r /tmp/build", "rm -R -f target", "rm -f -R target", "rm --recursive --force target", "rm -r --force target", "rm --force -R target"],
    not_match = ["rm -r dir", "rm -f file", "rm --recursive dir", "rm --force file"],
)

prefix_rule(
    pattern = ["rm", ["-rf", "-fr", "-Rf", "-fR"]],
    decision = "prompt",
    match = ["rm -rf target", "rm -fr /tmp/build", "rm -Rf target", "rm -fR target"],
    not_match = ["rm file.txt", "rm -r dir"],
)

prefix_rule(
    pattern = ["git", "-C"],
    decision = "prompt",
    match = ["git -C . push --force", "git -C . reset --hard", "git -C . clean -fd"],
    not_match = ["git status", "git push origin main"],
)

prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    match = ["git push origin main", "git push origin main --force", "git push origin +main"],
    not_match = ["git status", "git pull"],
)

prefix_rule(
    pattern = ["git", "push", ["-f", "--force"]],
    decision = "forbidden",
    match = ["git push --force", "git push -f origin main"],
    not_match = ["git push origin main", "git push --force-with-lease"],
)
