prefix_rule(
    pattern = ["cargo", "publish"],
    decision = "prompt",
    justification = "Publishing crates to crates.io requires maintainer review.",
    match = ["cargo publish", "cargo publish -p aether-crypto"],
    not_match = ["cargo test", "cargo build"],
)

prefix_rule(
    pattern = ["gh", "release", "delete"],
    decision = "prompt",
    justification = "gh release delete removes a published GitHub release. Confirm intent before discarding release assets and notes.",
    match = ["gh release delete v0.3.0"],
    not_match = ["gh release create", "gh release view"],
)

prefix_rule(
    pattern = ["git", "clean", ["-d", "-f"], ["-d", "-f"]],
    decision = "prompt",
    justification = "git clean with separated -d -f flags deletes untracked files. Confirm intent before discarding work.",
    match = ["git clean -f -d", "git clean -d -f src/"],
    not_match = ["git clean -n", "git clean --dry-run"],
)

prefix_rule(
    pattern = ["git", "clean", ["-df", "-dfx", "-fd", "-fdx"]],
    decision = "prompt",
    justification = "git clean -fd deletes untracked files. Confirm intent before discarding work.",
    match = ["git clean -fd", "git clean -fdx src/"],
    not_match = ["git clean -n", "git clean --dry-run"],
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "prompt",
    justification = "Hard reset silently discards uncommitted changes. Confirm intent before resetting; use --keep to refuse if work would be lost.",
    match = ["git reset --hard", "git reset --hard HEAD~1"],
    not_match = ["git reset --soft HEAD~1", "git reset HEAD file.rs", "git reset --keep HEAD~1"],
)

prefix_rule(
    pattern = ["git", "tag", ["-d", "--delete"]],
    decision = "prompt",
    justification = "git tag -d deletes a local tag. Confirm before removing — local-only deletion is recoverable from remote, but releases lose their reference if both sides are deleted.",
    match = ["git tag -d v0.3.0", "git tag --delete v0.3.0"],
    not_match = ["git tag", "git tag v0.4.0"],
)

prefix_rule(
    pattern = ["rm", ["-r", "-f"], ["-r", "-f"]],
    decision = "prompt",
    justification = "Recursive force delete with separated flags is destructive. Confirm the target path.",
    match = ["rm -r -f target", "rm -f -r /tmp/build"],
    not_match = ["rm -r dir", "rm -f file"],
)

prefix_rule(
    pattern = ["rm", ["-rf", "-fr"]],
    decision = "prompt",
    justification = "Recursive force delete is destructive. Confirm the target path.",
    match = ["rm -rf target", "rm -fr /tmp/build"],
    not_match = ["rm file.txt", "rm -r dir"],
)

prefix_rule(
    pattern = ["cargo", "yank"],
    decision = "forbidden",
    justification = "cargo yank withdraws a published version from crates.io and breaks downstream consumers. Coordinate manually instead.",
    match = ["cargo yank --vers 0.3.0", "cargo yank --version 0.3.0 aether-crypto"],
    not_match = ["cargo test", "cargo publish"],
)

prefix_rule(
    pattern = ["git", "push", ["-f", "--force"]],
    decision = "forbidden",
    justification = "Force push is forbidden. Use --force-with-lease instead.",
    match = ["git push --force", "git push -f origin main"],
    not_match = ["git push origin main", "git push --force-with-lease"],
)
