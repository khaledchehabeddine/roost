{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "aether_project_root=\"$(git rev-parse --show-toplevel)\" && bash \"$aether_project_root/scripts/hooks/enforce-git-boundary.sh\" || exit 2"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/deny-on-commit.sh"
          }
        ]
      },
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "scripts/check.sh quick"
          }
        ]
      }
    ]
  }
}
